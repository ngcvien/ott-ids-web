{
  "name": "lastdance-alerts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:rules": "firebase emulators:exec --project demo-lastdance --only firestore \"node --test tests/firestore.rules.test.mjs\"",
    "firebase:login": "firebase login",
    "firebase:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "bootstrap": "node --env-file=.env.local scripts/bootstrap.mjs",
    "device:key": "node --env-file=.env.local scripts/device-key.mjs",
    "send:test-alert": "node scripts/send-test-alert.mjs",
    "test:ingestion": "firebase emulators:exec --project demo-lastdance --only firestore \"node --test tests/ingestion.test.mjs\"",
    "test:attention": "node --test tests/attack-detector.test.mjs",
    "test:alerts": "firebase emulators:exec --project demo-lastdance --only firestore \"node --test tests/ingestion.test.mjs tests/clear-alerts.test.mjs tests/heartbeat.test.mjs tests/firestore.rules.test.mjs\"",
    "test:presence": "node --test tests/device-presence.test.mjs",
    "test:runtime": "node --no-experimental-require-module --test tests/firebase-runtime.test.mjs",
    "prebuild": "npm run test:runtime",
    "test:details": "node --test tests/alert-details.test.mjs",
    "test:charts": "node --test tests/alert-analytics.test.mjs",
    "test:all": "firebase emulators:exec --project demo-lastdance --only firestore \"node --no-experimental-require-module --test tests/*.test.mjs\"",
    "model:pack": "node scripts/pack-model.mjs",
    "test:models": "firebase emulators:exec --project demo-lastdance --only firestore \"node --test tests/models.test.mjs tests/firestore.rules.test.mjs tests/heartbeat.test.mjs\""
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.3.0",
    "firebase": "13.4.0",
    "firebase-admin": "14.5.1",
    "gsap": "^3.15.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "firebase-tools": "15.37.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "5.10.0"
    }
  },
  "engines": {
    "node": ">=24 <25"
  }
}
