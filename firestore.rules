rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(orgId) {
      return signedIn() &&
        get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role in ['owner', 'viewer'];
    }
    // An admin-maintained index tells a user which organizations they can open.
    // It is not used as the source of truth for access to organization data.
    match /users/{uid}/memberships/{orgId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /organizations/{orgId} {
      allow get: if member(orgId);
      allow list, write: if false;
      match /members/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list, write: if false;
      }
      match /devices/{deviceId} {
        allow read: if member(orgId);
        allow write: if false;
        match /alerts/{alertId} {
          allow get: if member(orgId);
          allow list: if member(orgId) && request.query.limit != null && request.query.limit <= 100;
          allow write: if false;
        }
      }
    }
    // Device secrets and all unspecified paths are never exposed to browsers.
    match /{document=**} { allow read, write: if false; }
  }
}
