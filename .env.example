# Copy to .env.local. Get all values from Firebase Project settings > Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server/admin scripts only: path to a credential OUTSIDE this repository.
# Do not put service account JSON in NEXT_PUBLIC_* variables.
GOOGLE_APPLICATION_CREDENTIALS=

# Vercel server only: use these instead of a local credential file path.
# Do not prefix any server credential with NEXT_PUBLIC_.
# FIREBASE_PROJECT_ID must match NEXT_PUBLIC_FIREBASE_PROJECT_ID.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
